//
//  Project.xcconfig
//  Hitoashi
//
//  プロジェクト共通のビルド設定。
//  テンプレートから新規リポジトリを作成したら、まずこのファイルの値を書き換える。
//  （pbxproj 側にはこれらの値を直接書かず、ここだけを編集する）
//

// Apple Developer Program の Team ID
DEVELOPMENT_TEAM = XU74X3434S

// アプリ本体の Bundle Identifier。
// テストターゲットは $(APP_BUNDLE_IDENTIFIER).Tests / .UITests として派生させる
APP_BUNDLE_IDENTIFIER = jp.shilokuma.Hitoashi

// バージョン（CFBundleShortVersionString / CFBundleVersion）
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// 対応プラットフォーム。1 つのアプリターゲットで iOS / macOS / visionOS をビルドする
// （pbxproj 側は SDKROOT = auto と TARGETED_DEVICE_FAMILY = 1,2,7 だけを持つ）
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx xros xrsimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

// 最低サポート OS。Liquid Glass の標準部品と MapKit のジオコーディング（MKGeocodingRequest）を前提にする
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
XROS_DEPLOYMENT_TARGET = 26.0

// Mac 版は Apple Silicon のみ（Intel Mac の検証をしないため）
ARCHS[sdk=macosx*] = arm64

// Mac 版は App Sandbox と Hardened Runtime を有効にする（entitlements は Configs/HitoashiMac.entitlements）
ENABLE_HARDENED_RUNTIME[sdk=macosx*] = YES
